# Falcon 3D Prints — Environment Variables Reference
# Copy this file to .env.local for development.

# Public Configuration (Exposed to Browser)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Falcon 3D Prints"
NEXT_PUBLIC_CONTACT_PHONE="+91 98506 07144"
NEXT_PUBLIC_CONTACT_ADDRESS="Uttam Nagar, CIDCO, Nashik, Maharashtra 422009, India"

# Supabase Integration (When empty, deterministic local preview store is used)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Razorpay Payment Gateway (When empty, test sandbox simulation is used)
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Server-Only Secrets (Never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ADMIN_SESSION_SECRET=falcon_preview_session_secret_32chars

# Cloudflare R2 Object Storage (Zero Egress Bandwidth for CAD Models & Media)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_CAD_BUCKET_NAME=falcon-cad-models
R2_MEDIA_BUCKET_NAME=falcon-product-images
NEXT_PUBLIC_R2_PUBLIC_URL=
