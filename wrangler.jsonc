{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "website",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "website"
    }
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "falcon-3d-prints-opennext-cache"
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://falcon3dprints.com",
    "NEXT_PUBLIC_SUPABASE_URL": "https://wkkoviqhmccjnocjfudq.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Indra292aXFobWNjam5vY2pmdWRxIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTE3MTY0ODYsImV4cCI6MjEwNzI5MjQ4Nn0.MK9cn5kqom-GvaZTV-7__imhPd-Y_2r2rH3TOi0Zdfc"
  }
}
